# ==============================================================================
# KRCE Green Campus — Supabase Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ==============================================================================

# Your Supabase project URL
# Found in: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase publishable (anon) key
# Found in: Supabase Dashboard → Project Settings → API → Project API keys → anon / public
# Note: Newer Supabase projects label this as "Publishable key"
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# ==============================================================================
# HOW TO SET UP SUPABASE
# ==============================================================================
# 1. Go to https://supabase.com → create a free project
# 2. In the SQL Editor, run the contents of supabase/schema.sql
# 3. Copy your Project URL and Publishable (anon) key from the API settings
# 4. Paste them above in .env.local
# 5. Restart the Vite dev server: npm run dev
# ==============================================================================
